# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Jupyter checkpoints
.ipynb_checkpoints/

# Temporary files and logs
*.tmp
*.temp
*.swp
*.swo
*~
*.log

# Build and packaging output
build/
dist/
*.egg-info/

