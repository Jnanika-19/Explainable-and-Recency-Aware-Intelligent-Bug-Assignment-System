# Large raw datasets: keep directory placeholders, never dataset contents
/data/raw/*


# Large datasets
dataset/raw/*
dataset/processed/*

# Keep directory placeholders
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep

# Keep small sample datasets
!dataset/sample/
!dataset/sample/**

# Existing data directory placeholder
!/data/raw/.gitkeep

# Python virtual environments
.venv/
.venv-sbert/
__pycache__/
*.py[cod]

# Python virtual environments
.venv/
.venv-sbert/
venv/

# Large processed datasets
dataset/processed/*

# Keep folder placeholders
!dataset/processed/.gitkeep
!dataset/raw/.gitkeep

# Keep small sample datasets
!dataset/sample/
!dataset/sample/**
# Allow dataset documentation, but keep processed data private
!dataset/processed/member1_dataset_files/
dataset/processed/member1_dataset_files/*
!dataset/processed/member1_dataset_files/README.md

dataset/external/*
